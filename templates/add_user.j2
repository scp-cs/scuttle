{% extends "base.j2" %}

{% set hide_sidebar = true %}

{% block content %}
<div class="flex flex-col p-10">
<h1 class="text-4xl font-bold">Přidat uživatele</h1>
<hr class="my-4 border-white">
<form method="post" class="md:w-1/2 flex flex-col w-full text-lg">
    {{ form.hidden_tag() }}
    {{form.nickname.label(class='form-label')}}
    {{form.nickname(class='input-field mb-4', id='input-title')}}
    {{form.wikidot.label(class='form-label')}}
    {{form.wikidot(class='input-field mb-4', id='input-link')}}
    {{form.discord.label(class='form-label')}}
    {{form.discord(class='input-field mb-4')}}
    <div class="form-label">
    Možnosti:
    </div>
    <span class="mb-6">
    <span class="inline">
    {{form.can_login(class='peer hidden')}}
    {{form.can_login.label(class='tiny-btn bg-white/5 inline-block peer-checked:border-green-600 border-red-600 select-none', id='check-login')}}
    </span>
    </span>
    {{form.submit(class='md:w-36 glass-btn self-start w-full ')}}
</form>
</div>

{% endblock content %}