{% extends "base.j2" %}

{% set title = "Nastavení API"%}

{% block content %}
<div class="flex flex-col gap-2 px-5 mt-2 flex-start h-full">
    <h1 class="mt-2 text-4xl text-center">Nastavení API</h1>
    <div class="flex flex-col flex-wrap gap-4 w-full min-h-36 items-center">
      <div class="w-3/4">
        <table class="w-full bg-white/10 border mt-5 border-white/30 rounded-md border-separate p-4">
          <tr>
            <th>ID</th>
            <th>Klíč</th>
            <th>Vlastník</th>
            <th>Oprávnění</th>
            <th>Poznámka</th>
            <th>Vytvořeno</th>
            <th></th>
          </tr>
          {% for key in keys %}
          <tr>
          
            <td>{{ key.get_id() }}</td>
            <td>{{ key.key }}</td>
            <td>{{ key.generated_by.nickname }}</td>
            <td>N/A</td>
            <td>{{ key.note or 'N/A'}}</td>
            <td>30.07.2026 12:50</td>
            <td><form action="{{url_for('DebugToolsController.remove_api_key')}}" method="post"><button name="id" class="tiny-btn" type="submit" value="{{key.get_id()}}">Deaktivovat</button></form></td>
          </tr>
          {% endfor %}
        </table>
    
        <form action="{{url_for('DebugToolsController.new_api_key')}}" class="mt-3" method="post">
          
          <button type="submit" class="glass-btn mr-3">Vytvořit nový klíč</button>
          <label for="note">Název / Poznámka:</label>
          <input type="text" name="note" class="input-field border rounded-md">
        </form>

        {% if newkey %}
        <div class="w-full text-center mt-3">
          <p>Váš API klíč je: <span class="text-green-500">{{newkey}}</span>. Zapište si ho, nebude zobrazen znovu.</p>
        </div>
        {% endif %}
      </div>
    </div>
</div>
{% endblock content %}