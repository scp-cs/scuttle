{% extends "base.j2" %}

{% block content %}
<div class="w-full h-full flex flex-col items-center justify-center">
  <form method="post" class="flex flex-col items-center">
    {{ form.hidden_tag() }}
    <div class="p-4 grid grid-flow-col grid-cols-2 grid-rows-6 gap-6 border border-white/50 rounded-lg mb-3 backdrop-blur-sm">
      {% for p in form.perms %}
      <div class="permission-container">
      <span>
        {{p(class='peer hidden')}}
        {{p.label(class='permission-toggle w-56 block')}}
        </span>
        <p class="ml-10 text-sm">
        {{p.description}}
        </p>
      </div>
      {% endfor %}
    </div>
    {{form.submit(class='px-4 py-3 bg-white/5 hover:bg-white/20 transition-all border border-white/50 w-min rounded-md')}}
  </form>
</div>
{% endblock content %} 