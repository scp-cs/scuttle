{% extends "base.j2" %}

{% set title = "Upravit článek"%}
{% set hide_sidebar = true %}

{% block content %}
<div class="flex flex-col p-10">
<h1 class="text-4xl font-bold">Upravit článek</h1>
<hr class="my-4 border-white">
<form method="post" class="md:w-1/2 flex flex-col w-full text-lg">
    {{ form.hidden_tag() }}
    {{form.title.label(class='form-label')}}
    {{form.title(class='input-field mb-4', id='input-title')}}
    {{form.link.label(class='form-label')}}
    {{form.link(class='input-field mb-4', id='input-link')}}
    {{form.translator.label(class='form-label')}}
    {{form.translator(class='opacity-60 input-field mb-4 select-none', disabled='')}}
    {{form.words.label(class='form-label')}}
    {{form.words(class='input-field mb-4')}}
    {{form.bonus.label(class='form-label')}}
    {{form.bonus(class='input-field mb-4')}}
    <div class="form-label">
    Možnosti:
    </div>
    <span class="inline mb-4">
    {{form.excluded(class='peer hidden')}}
    {{form.excluded.label(class='tiny-btn bg-white/5 inline-block peer-checked:border-green-600 border-red-600 select-none')}}
    </span>
    {{form.submit(class='md:w-36 glass-btn self-start w-full')}}
</form>
</div>

<script src="{{url_for('static', filename='js/newarticle.js')}}"></script>
{% endblock content %}